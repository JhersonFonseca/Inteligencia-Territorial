# Copia este archivo como .env y cambia la contraseña local antes de usarlo.
# Estos valores son solo para el entorno local de desarrollo. No subas .env al repositorio.

POSTGRES_DB=territorial
POSTGRES_USER=territorial
POSTGRES_PASSWORD=cambia-esta-clave-local

# Cadena de conexión que usa la API dentro de Docker Compose
TERRITORIAL_DB=postgresql://territorial:cambia-esta-clave-local@db:5432/territorial

# Puerto local de la API y del mapa
TERRITORIAL_PUERTO=8000

# Contacto que se envía en el encabezado User-Agent al consultar los servicios oficiales
TERRITORIAL_CONTACTO=pon-aqui-tu-correo-de-contacto
# Base exclusiva para pruebas automáticas (se crea sola la primera vez). Debe terminar en _pruebas.
TERRITORIAL_DB_PRUEBAS=postgresql://territorial:cambia-esta-clave-local@db:5432/territorial_pruebas
# Puerto local de PostgreSQL (cámbialo si ya usas el 5432 en tu equipo)
TERRITORIAL_PUERTO_BD=5432
# 1 solo para ver la demostración con datos INVENTADOS. Déjalo en 0 al cargar datos reales.
TERRITORIAL_PERMITIR_SINTETICOS=0
# Solo si tu red exige proxy para salir a Internet (p. ej. http://proxy.empresa:8080). Si no, déjalo vacío.
TERRITORIAL_HTTPS_PROXY=
TERRITORIAL_HTTP_PROXY=
